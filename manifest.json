{
  "manifest_version": 3,
  "name": "Hyperclip",
  "version": "1.0.0",
  "description": "Adds copy-link buttons to supported websites (currently thecodinglove.com and GitHub).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://thecodinglove.com/*"],
      "js": ["scripts/shared.js", "scripts/sites/thecodinglove.js"],
      "css": ["styles/thecodinglove.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["scripts/shared.js", "scripts/sites/github.js"],
      "css": ["styles/github.css"],
      "run_at": "document_idle"
    }
  ]
}
